NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://cosoremi:replace-me@localhost:5432/cosoremi"
SESSION_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional, used only when seeding a new administrator:
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Docker development works without this file; these are optional host ports.
DEV_PORT=3000
STUDIO_PORT=5555
DEV_SESSION_SECRET=

# Production Compose: copy this file to .env.production and fill every secret.
# Set NODE_ENV=production, APP_URL=https://your-domain and a random SESSION_SECRET.
# DATABASE_URL must use postgres:5432 and match POSTGRES_* below.
# Percent-encode special characters in the DATABASE_URL username/password.
POSTGRES_DB=cosoremi
POSTGRES_USER=
POSTGRES_PASSWORD=
COSOREMI_IMAGE=ghcr.io/prinako/cosoremi-portal:latest
APP_BIND_ADDRESS=127.0.0.1
