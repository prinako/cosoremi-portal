{
  "name": "cosoremi-portal",
  "version": "1.0.0",
  "description": "Portal institucional e sistema de gestão de conteúdo do COSOREMI.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:integration": "node --test --test-isolation=none tests/integration/*.test.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cosoremi",
    "express",
    "cms"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^4.22.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "zod": "^4.1.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
