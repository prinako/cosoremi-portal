<%- include('partials/header') %>
<h1><%= item.id ? 'Editar' : 'Criar' %> · <%= spec.label %></h1>
<form method="post" enctype="multipart/form-data" class="contact-form cms-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">

  <% fields.forEach(field => { %>
  <label id="<%= field.name %>-label" for="<%= field.name %>"><%= field.label %></label>
  <% if (field.type === 'rich-content') { %>
  <div
    class="rich-content-editor"
    data-rich-content-field
    data-editor-style-nonce="<%= typeof cspNonce === 'string' ? cspNonce : '' %>"
  >
    <textarea
      id="<%= field.name %>"
      name="<%= field.name %>"
      maxlength="<%= field.maxLength %>"
      rows="<%= field.rows %>"
      aria-describedby="<%= field.describedBy %>"
      <%= field.required ? 'required' : '' %>
    ><%= item[field.name] || '' %></textarea>
    <input
      type="hidden"
      name="contentBlocks"
      value="<%= item.contentBlocks ? JSON.stringify(item.contentBlocks) : '' %>"
      disabled
    >
    <div
      class="rich-content-editor__surface"
      data-editor-holder
      role="group"
      aria-labelledby="<%= field.name %>-label"
      aria-describedby="<%= field.describedBy %>"
      hidden
    ></div>
    <p
      class="form-error"
      data-editor-error
      role="alert"
      tabindex="-1"
      hidden
    ></p>
  </div>
  <% } else if (field.type === 'textarea') { %>
  <textarea
    id="<%= field.name %>"
    name="<%= field.name %>"
    maxlength="<%= field.maxLength %>"
    rows="<%= field.rows %>"
    <% if (field.describedBy) { %>aria-describedby="<%= field.describedBy %>"<% } %>
    <%= field.required ? 'required' : '' %>
  ><%= item[field.name] || '' %></textarea>
  <% } else { %>
  <input
    id="<%= field.name %>"
    name="<%= field.name %>"
    maxlength="<%= field.maxLength %>"
    value="<%= item[field.name] || '' %>"
    <%= field.required ? 'required' : '' %>
  >
  <% } %>
  <% }) %>

  <% if (fields.some(field => field.type === 'rich-content')) { %>
  <p id="rich-content-help">
    Estruture o texto com títulos, listas, citações e links. Se o editor visual
    não carregar, o campo de texto simples continua disponível.
  </p>
  <% } %>

  <% if (fields.some(field => field.describedBy === 'plain-text-help')) { %>
  <p id="plain-text-help">
    O conteúdo é texto simples. Separe os parágrafos com uma linha em branco.
  </p>
  <% } %>

  <% if (resource === 'posts') { %>
  <label for="status">Estado</label>
  <select id="status" name="status">
    <% [['DRAFT','Rascunho'],['PUBLISHED','Publicado'],['ARCHIVED','Arquivado']].forEach(([value,label]) => { %>
    <option value="<%= value %>" <%= item.status === value ? 'selected' : '' %>><%= label %></option>
    <% }) %>
  </select>

  <label for="categoryId">Categoria</label>
  <select id="categoryId" name="categoryId">
    <option value="">Sem categoria</option>
    <% categories.forEach(category => { %>
    <option value="<%= category.id %>" <%= item.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option>
    <% }) %>
  </select>

  <label for="publishedAt">Publicação (UTC; deixe vazio para publicar agora)</label>
  <input
    id="publishedAt"
    name="publishedAt"
    type="datetime-local"
    value="<%= item.publishedAt ? item.publishedAt.toISOString().slice(0,16) : '' %>"
    aria-describedby="published-at-help"
  >
  <p id="published-at-help">
    Uma data futura agenda a publicação. Para mostrar o artigo imediatamente,
    selecione “Publicado” e deixe este campo vazio.
  </p>
  <% } %>

  <% if (resource === 'work-areas') { %>
  <label for="displayOrder">Ordem de exibição</label>
  <input
    id="displayOrder"
    name="displayOrder"
    type="number"
    min="0"
    max="10000"
    value="<%= item.displayOrder || 0 %>"
    required
  >
  <label class="checkbox">
    <input type="checkbox" name="active" <%= !item.id || item.active ? 'checked' : '' %>> Ativo
  </label>
  <% } %>

  <% if (resource === 'gallery') { %>
  <label for="activityDate">Data da atividade</label>
  <input
    id="activityDate"
    name="activityDate"
    type="date"
    value="<%= item.activityDate ? item.activityDate.toISOString().slice(0,10) : '' %>"
  >
  <% } %>

  <% if (['pages', 'gallery'].includes(resource)) { %>
  <label class="checkbox">
    <input type="checkbox" name="published" <%= item.published ? 'checked' : '' %>> Publicado
  </label>
  <% } %>

  <% if (spec.image) { %>
  <label for="image">Imagem</label>
  <input
    id="image"
    name="image"
    type="file"
    accept="image/jpeg,image/png,image/webp"
    aria-describedby="image-help"
    <%= resource === 'gallery' && !item.id ? 'required' : '' %>
  >
  <p id="image-help">JPG, PNG ou WebP; até 5 MB.</p>
  <% if (item[spec.image]) { %>
  <img
    class="upload-preview"
    src="<%= item[spec.image] %>"
    alt="Imagem atual de <%= item.title || item.name || spec.label %>"
  >
  <% if (resource !== 'gallery') { %>
  <label class="checkbox">
    <input type="checkbox" name="removeImage"> Remover imagem atual
  </label>
  <% } %>
  <% } %>
  <% } %>

  <% if (['pages', 'posts', 'work-areas'].includes(resource)) { %>
  <fieldset
    class="seo-editor"
    data-seo-controls
    data-resource="<%= resource %>"
    data-app-url="<%= seoPreview.appUrl %>"
    data-site-name="<%= seoPreview.siteName %>"
    data-site-description="<%= seoPreview.siteDescription %>"
    data-reserved-page-routes="<%= JSON.stringify(seoPreview.reservedPageRoutes) %>"
  >
    <legend>Busca e compartilhamento</legend>
    <label for="seoTitle">Título SEO</label>
    <input
      id="seoTitle"
      name="seoTitle"
      maxlength="180"
      value="<%= item.seoTitle || '' %>"
      aria-describedby="seo-title-help seo-title-count"
      data-seo-title
    >
    <p id="seo-title-help" class="field-help">
      Se ficar vazio, o título da página será usado automaticamente.
    </p>
    <p id="seo-title-count" class="character-count" data-character-count="seoTitle">
      <%= (item.seoTitle || '').length %> / 180
    </p>
    <label for="seoDescription">Descrição SEO</label>
    <textarea
      id="seoDescription"
      name="seoDescription"
      rows="3"
      maxlength="320"
      aria-describedby="seo-description-help seo-description-count"
      data-seo-description
    ><%= item.seoDescription || '' %></textarea>
    <p id="seo-description-help" class="field-help">
      Se ficar vazia, o resumo, subtítulo ou descrição padrão do site será
      usado.
    </p>
    <p id="seo-description-count" class="character-count" data-character-count="seoDescription">
      <%= (item.seoDescription || '').length %> / 320
    </p>

    <section class="search-preview" aria-labelledby="search-preview-heading">
      <h2 id="search-preview-heading">Prévia de busca</h2>
      <p class="field-help">
        Esta é uma aproximação. Os mecanismos de busca podem exibir textos
        diferentes.
      </p>
      <p class="search-preview__title" data-preview-title><%= seoPreview.title %></p>
      <p class="search-preview__url" data-preview-url><%= seoPreview.url %></p>
      <p class="search-preview__description" data-preview-description><%= seoPreview.description %></p>
    </section>
  </fieldset>
  <% } %>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">Salvar</button>
    <a class="btn" href="/admin/<%= resource %>">Cancelar</a>
  </div>
</form>
<% if (['pages', 'posts', 'work-areas'].includes(resource)) { %>
<script src="/js/admin-seo.js" type="module"></script>
<% } %>
<%- include('partials/footer') %>
