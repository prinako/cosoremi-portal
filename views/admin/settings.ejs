<%- include('partials/header') %>
<h1>Configurações do site</h1>
<form method="post" enctype="multipart/form-data" class="contact-form cms-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>" />

  <fieldset class="branding-panel">
    <legend>Identidade visual</legend>

    <div class="branding-colors">
      <div class="color-control">
        <label for="primary_color">Cor primária</label>
        <input
          id="primary_color"
          name="primary_color"
          type="color"
          value="<%= values.primary_color || '#0f5f46' %>"
          required
        >
        <code><%= values.primary_color || '#0f5f46' %></code>
      </div>

      <div class="color-control">
        <label for="secondary_color">Cor secundária</label>
        <input
          id="secondary_color"
          name="secondary_color"
          type="color"
          value="<%= values.secondary_color || '#f5c84b' %>"
          required
        >
        <code><%= values.secondary_color || '#f5c84b' %></code>
      </div>
    </div>

    <div class="logo-settings">
      <label for="logo">Logo do site</label>
      <% if (values.site_logo) { %>
        <div class="logo-preview">
          <img src="<%= values.site_logo %>" alt="Logo atual do site">
        </div>
        <label>
          <input type="checkbox" name="removeLogo">
          Remover logo atual
        </label>
      <% } %>
      <input
        id="logo"
        name="logo"
        type="file"
        accept="image/jpeg,image/png,image/webp"
      >
      <p class="branding-help">JPG, PNG ou WebP, até 5 MB. O arquivo é reprocessado com segurança antes de ser publicado.</p>
    </div>

    <div class="settings-image">
      <label for="favicon">Favicon do site</label>
      <% if (values.site_favicon) { %>
      <div class="settings-image-preview">
        <img src="/favicon.png" alt="Favicon atual do site" width="48" height="48">
      </div>
      <label class="checkbox">
        <input type="checkbox" name="removeFavicon">
        Remover favicon atual
      </label>
      <% } %>
      <input
        id="favicon"
        name="favicon"
        type="file"
        accept="image/png,image/jpeg"
        aria-describedby="favicon-help"
      >
      <p id="favicon-help" class="branding-help">
        Ícone usado nas abas do navegador e que pode aparecer nos resultados de busca.
        Use uma imagem quadrada; recomendamos pelo menos 48 × 48 px. PNG ou JPG,
        até 2 MB. O servidor publica uma versão PNG segura.
      </p>
    </div>
  </fieldset>

  <fieldset class="seo-settings-panel">
    <legend>SEO e compartilhamento</legend>
    <p>
      Personalize os textos das páginas de listagem. Os mecanismos de busca
      podem exibir textos diferentes conforme a pesquisa.
    </p>

    <% [
      ['blog', 'Blog'],
      ['work_areas', 'Linhas de trabalho'],
      ['gallery', 'Galeria']
    ].forEach(([prefix, label]) => { %>
    <section class="seo-settings-group" aria-labelledby="<%= prefix %>-seo-heading">
      <h2 id="<%= prefix %>-seo-heading"><%= label %></h2>
      <label for="<%= prefix %>_seo_title">Título SEO</label>
      <input
        id="<%= prefix %>_seo_title"
        name="<%= prefix %>_seo_title"
        maxlength="180"
        value="<%= values[`${prefix}_seo_title`] || '' %>"
        aria-describedby="<%= prefix %>-seo-title-help"
      >
      <p id="<%= prefix %>-seo-title-help" class="field-help">
        Deixe em branco para usar o título automático.
      </p>
      <label for="<%= prefix %>_seo_description">Descrição SEO</label>
      <textarea
        id="<%= prefix %>_seo_description"
        name="<%= prefix %>_seo_description"
        rows="3"
        maxlength="320"
        aria-describedby="<%= prefix %>-seo-description-help"
      ><%= values[`${prefix}_seo_description`] || '' %></textarea>
      <p id="<%= prefix %>-seo-description-help" class="field-help">
        Deixe em branco para usar a descrição padrão.
      </p>
    </section>
    <% }) %>

    <div class="settings-image">
      <label for="socialImage">Imagem padrão de compartilhamento</label>
      <% if (values.default_social_image) { %>
      <div class="settings-image-preview settings-image-preview--social">
        <img
          src="<%= values.default_social_image %>"
          alt="Imagem padrão atual de compartilhamento"
        >
      </div>
      <label class="checkbox">
        <input type="checkbox" name="removeSocialImage">
        Remover imagem padrão atual
      </label>
      <% } %>
      <input
        id="socialImage"
        name="socialImage"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        aria-describedby="social-image-help"
      >
      <p id="social-image-help" class="field-help">
        Usada em compartilhamentos quando a página não possui uma imagem
        própria. Recomendação: 1200 × 630 px. JPG, PNG ou WebP, até 5 MB.
      </p>
    </div>
  </fieldset>

  <% Object.entries(fields).forEach(([key,[label]]) => {
       if (key === 'primary_color' || key === 'secondary_color' || seoFieldKeys.includes(key)) return; %>
    <label for="<%= key %>"><%= label %></label>
    <textarea
      id="<%= key %>"
      name="<%= key %>"
      rows="<%= key.endsWith('_text') ? 5 : 2 %>"
      maxlength="<%= key.endsWith('_text') ? 5000 : 500 %>"
    ><%= values[key] || '' %></textarea>
  <% }) %>

  <button class="btn btn-primary" type="submit">
    Salvar configurações
  </button>
</form>
<%- include('partials/footer') %>
