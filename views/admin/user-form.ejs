<%- include('partials/header') %>
<h1><%= item.id ? 'Editar usuário' : 'Criar usuário' %>
</h1>
<form method="post" class="contact-form cms-form">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<label for="name">Nome</label>
<input id="name" name="name" value="<%= item.name || '' %>" minlength="2" maxlength="120" required>
<label for="email">E-mail</label>
<input id="email" name="email" type="email" maxlength="254" value="<%= item.email || '' %>" required>
<label for="role">Perfil</label>
<select id="role" name="role">
<% ['EDITOR','ADMIN','SUPER_ADMIN'].forEach(role => { %>
<option <%= item.role === role ? 'selected' : '' %>><%= role %>
</option>
<% }) %>
</select>
<label class="checkbox">
<input type="checkbox" name="active" <%= !item.id || item.active ? 'checked' : '' %>> Ativo</label>
<label for="password"><%= item.id ? 'Nova senha (deixe vazio para manter)' : 'Senha' %>
</label>
<input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="72" <%= item.id ? '' : 'required' %>>
<p>Use pelo menos 12 caracteres e no máximo 72 bytes. Alterações encerram as sessões do usuário.</p>
<button class="btn btn-primary" type="submit">Salvar usuário</button>
</form><%- include('partials/footer') %>
