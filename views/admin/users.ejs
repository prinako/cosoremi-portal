<%- include('partials/header') %>
<div class="section-heading">
  <h1>Usuários</h1>
  <a class="btn btn-primary" href="/admin/users/new">Criar usuário</a>
</div>
<div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>E-mail</th>
        <th>Perfil</th>
        <th>Estado</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(item => { %>
      <tr>
        <td><%= item.name %></td>
        <td><%= item.email %></td>
        <td><%= item.role %></td>
        <td><%= item.active ? 'Ativo' : 'Inativo' %></td>
        <td>
          <a class="btn" href="/admin/users/<%= item.id %>/edit">Editar</a>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination') %><%- include('partials/footer') %>
