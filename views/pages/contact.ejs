<%- include('../partials/header') %>
<section class="page-hero">
  <div class="container">
    <h1><%= item.title %></h1>
    <p><%= item.subtitle %></p>
  </div>
</section>
<section class="section container contact-grid">
  <div>
    <div class="prose"><%= item.content %></div>
    <p>
      Envie apenas as informações necessárias para o primeiro contato. Não envie
      documentos, dados de saúde ou detalhes de processos pessoais.
    </p>
    <p class="info-box">
      Este formulário não é monitorado em tempo real e não é adequado para uma
      emergência com risco imediato à vida.
    </p>
    <a class="btn" href="/emergencia">Informações de emergência</a>
  </div>
  <form method="post" action="/contato" class="contact-form">
    <% if(sent) { %>
    <p class="form-success" role="status">
      Mensagem recebida. Obrigado pelo contato.
    </p>
    <% } %><input type="hidden" name="_csrf" value="<%= csrf %>" />
    <label for="name">Nome *</label
    ><input
      id="name"
      name="name"
      required
      minlength="2"
      maxlength="120"
      autocomplete="name"
    />
    <label for="email">E-mail *</label
    ><input
      id="email"
      name="email"
      type="email"
      required
      maxlength="254"
      autocomplete="email"
    />
    <label for="phone">Telefone / WhatsApp</label
    ><input
      id="phone"
      name="phone"
      type="tel"
      maxlength="30"
      autocomplete="tel"
    />
    <label for="nationality">Nacionalidade (opcional)</label
    ><input id="nationality" name="nationality" maxlength="80" />
    <label for="subject">Assunto *</label
    ><select id="subject" name="subject" required>
      <% subjects.forEach(s => { %>
      <option><%= s %></option>
      <% }) %>
    </select>
    <label for="message">Mensagem *</label
    ><textarea
      id="message"
      name="message"
      rows="7"
      minlength="10"
      maxlength="5000"
      required
    ></textarea
    ><button class="btn btn-primary" type="submit">Enviar mensagem</button>
  </form>
</section>
<%- include('../partials/footer') %>
