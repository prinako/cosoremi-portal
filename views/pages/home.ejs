<%- include('../partials/header') %>
<section class="hero section-deep">
  <div class="hero-media placeholder-image">
    <% if(item.heroImage) { %><img
      src="<%= item.heroImage %>"
      alt=""
      fetchpriority="high"
    /><% } %>
  </div>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <p class="eyebrow"><%= settings.site_name %></p>
    <h1><%= item.title %></h1>
    <p><%= item.subtitle %></p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/emergencia"><%= settings.help_cta %></a
      ><a class="btn btn-secondary" href="/doar"><%= settings.donate_cta %></a>
    </div>
  </div>
</section>
<section class="section container">
  <div class="prose"><%= item.content %></div>
  <% if(about) { %>
  <h2><%= about.title %></h2>
  <p><%= about.subtitle %></p>
  <a class="btn" href="/sobre-nos">Conheça o COSOREMI</a><% } %>
</section>
<section class="section section-soft">
  <div class="container">
    <div class="section-heading">
      <h2>Linhas de trabalho</h2>
      <a href="/linhas-de-trabalho">Todas as linhas</a>
    </div>
    <%- include('../partials/cards',{items:areas,field:'image',base:'/linhas-de-trabalho'}) %>
  </div>
</section>
<section class="section container">
  <div class="section-heading">
    <h2>Notícias e histórias</h2>
    <a href="/blog">Todas as publicações</a>
  </div>
  <%- include('../partials/cards',{items:posts,field:'featuredImage',base:'/blog'}) %>
</section>
<section class="section section-soft">
  <div class="container">
    <div class="section-heading">
      <h2>Atividades recentes</h2>
      <a href="/galeria">Ver galeria</a>
    </div>
    <%- include('../partials/cards',{items:gallery,field:'image',base:''}) %>
  </div>
</section>
<section class="cta-section">
  <div class="container">
    <h2><%= settings.donate_cta %></h2>
    <p class="prose"><%= settings.donation_text %></p>
    <a class="btn btn-primary" href="/doar"><%= settings.donate_cta %></a>
  </div>
</section>
<section class="section container">
  <h2><%= settings.help_cta %></h2>
  <p class="prose"><%= settings.emergency_text %></p>
  <a class="btn btn-primary" href="/emergencia">Informações de emergência</a>
</section>
<%- include('../partials/footer') %>
