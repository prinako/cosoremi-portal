<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= pageDescription %>">
  <meta name="theme-color" content="<%= /^#[0-9a-fA-F]{6}$/.test(settings.primary_color || '') ? settings.primary_color : '#0f5f46' %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= currentUrl %>">
  <% if (image) { %>
  <meta property="og:image" content="<%= appUrl + image %>">
  <% } %>
  <link rel="canonical" href="<%= currentUrl %>">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/theme.css?v=<%= encodeURIComponent((settings.primary_color || '') + '-' + (settings.secondary_color || '')) %>">
  <link rel="stylesheet" href="/css/theme-gradients.css">
  <link rel="stylesheet" href="/css/branding.css">
  <title><%= pageTitle %>
  </title>
</head>

<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <header class="site-header" data-header>
    <nav class="navbar container" aria-label="Navegação principal">
      <a class="brand" href="/" aria-label="Página inicial">
        <% if (settings.site_logo) { %>
        <img class="brand-logo" src="<%= settings.site_logo %>" alt="" aria-hidden="true">
        <% } else { %>
        <span class="brand-mark" aria-hidden="true">C</span>
        <% } %>
        <span><%= settings.site_name || 'COSOREMI' %>
        </span>
      </a>
      <button class="nav-toggle" type="button" aria-label="Abrir menu" aria-controls="menu-principal" aria-expanded="false" data-nav-toggle>
        <span>
        </span>
        <span>
        </span>
        <span>
        </span>
      </button>
      <ul class="nav-menu" id="menu-principal" data-nav-menu>
        <% [['/sobre-nos','Sobre nós'],['/linhas-de-trabalho','Atuação'],['/blog','Blog'],['/galeria','Galeria'],['/contato','Contato'],['/emergencia','Ajuda'],['/doar','Doar']].forEach(([href,label]) => { %>
        <li>
          <a href="<%= href %>" class="<%= active === href ? 'active' : '' %>" <% if (active === href) { %>aria-current="page" <% } %>><%= label %>
          </a>
        </li>
        <% }) %>
      </ul>
    </nav>
  </header>
  <main id="conteudo">