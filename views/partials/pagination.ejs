<% if(pages > 1) { const suffix = typeof filter !== 'undefined' && filter ?
'&category=' + encodeURIComponent(filter) : ''; %>
<nav class="pagination" aria-label="Paginação">
  <% if(page > 1) { %><a
    class="btn"
    href="<%= base %>?page=<%= page - 1 %><%= suffix %>"
    >Anterior</a
  ><% } %><span
    >Página
    <%= page %>
    de
    <%= pages %></span
  ><% if(page < pages) { %><a
    class="btn"
    href="<%= base %>?page=<%= page + 1 %><%= suffix %>"
    >Próxima</a
  ><% } %>
</nav>
<% } %>
